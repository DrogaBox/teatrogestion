{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeatroGestión",
  "version": "1.3.0",
  "identifier": "com.teatrogestion.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": null,
    "beforeBuildCommand": "sh -c 'if [ -d ui ]; then cd ui && pnpm build; elif [ -d ../../ui ]; then cd ../../ui && pnpm build; elif [ -d ../../../../ui ]; then cd ../../../../ui && pnpm build; fi'",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TeatroGestión",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
